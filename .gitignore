# Data (not tracked — see data/README_data.md)
data/*.csv
data/*.xlsx
data/*.parquet

# Generated outputs (reproduced by running the scripts)
output/tables/*.csv
output/figures/*.png
output/figures/*.pdf
output/models/*.pkl
output/models/*.zip
output/models/*.pt

# Keep directory structure
!output/tables/.gitkeep
!output/figures/.gitkeep
!output/models/.gitkeep
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.env
.venv
env/
venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
